{
  "uid": "llm-observability",
  "title": "LLM Observability (Langfuse-style)",
  "tags": ["lgtm", "llm", "agent", "observability"],
  "description": "LLM 호출 상세 관측: 프롬프트/응답 탐색, 토큰/비용/레이턴시, 에러 추적. Langfuse 대체 대시보드.",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(llm_cost_usd_total, llm_model)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2
      },
      {
        "name": "agent_type",
        "label": "Agent",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(llm_cost_usd_total, agent_type)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "── KPI ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Total LLM Calls",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(agent_run_count_total{agent_type=~\"$agent_type\"})",
          "legendFormat": "Calls"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 3,
      "title": "Total Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(llm_cost_usd_total{llm_model=~\"$model\", agent_type=~\"$agent_type\"})",
          "legendFormat": "Cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Total Tokens",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(llm_token_usage_total{llm_model=~\"$model\", agent_type=~\"$agent_type\"})",
          "legendFormat": "Tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 100000 },
              { "color": "red", "value": 1000000 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Avg LLM Latency (P95)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_call_duration_bucket{llm_model=~\"$model\", agent_type=~\"$agent_type\"}[5m])))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(agent_error_count_total{agent_type=~\"$agent_type\"}[5m])) / sum(rate(agent_run_count_total{agent_type=~\"$agent_type\"}[5m])) * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 7,
      "title": "Cache Hit Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(cache_hit_count_total) / (sum(cache_hit_count_total) + sum(cache_miss_count_total)) * 100",
          "legendFormat": "Hit Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 60 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 10,
      "title": "── Trace Explorer (Prompt / Response) ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "LLM Call Traces (클릭 → 프롬프트/응답 상세 보기)",
      "description": "llm-call span 목록. TraceID 클릭 시 Tempo에서 프롬프트·응답·토큰·비용 확인 가능.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{ name = \"llm-call\" }",
          "queryType": "traceql",
          "limit": 50
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": false
            },
            "renameByName": {
              "traceID": "Trace ID",
              "traceName": "Operation",
              "startTime": "Start Time",
              "duration": "Duration (ms)",
              "traceService": "Service"
            }
          }
        }
      ],
      "options": {
        "sortBy": [{ "displayName": "Start Time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Tempo에서 열기",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22query%22:%22${__value.raw}%22,%22queryType%22:%22traceId%22%7D%5D%7D",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      }
    },

    {
      "id": 20,
      "title": "── Token & Cost Analytics ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Token Usage Rate (Prompt vs Completion)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (rate(llm_token_usage_total{llm_model=~\"$model\", agent_type=~\"$agent_type\"}[5m]))",
          "legendFormat": "{{type}} tokens/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 22,
      "title": "Cost Rate by Model ($/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (llm_model) (rate(llm_cost_usd_total{llm_model=~\"$model\", agent_type=~\"$agent_type\"}[5m])) * 60",
          "legendFormat": "{{llm_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 23,
      "title": "Avg Tokens per Request by Model",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (llm_model) (rate(llm_call_duration_sum{llm_model=~\"$model\"}[5m])) / sum by (llm_model) (rate(llm_call_duration_count{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "{{llm_model}} avg latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 24,
      "title": "Cumulative Cost by Agent Type",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (agent_type) (llm_cost_usd_total{agent_type=~\"$agent_type\"})",
          "legendFormat": "{{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      },
      "options": { "pieType": "donut", "tooltip": { "mode": "multi" } }
    },

    {
      "id": 30,
      "title": "── Latency Distribution ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "LLM Call Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, llm_model) (rate(llm_call_duration_bucket{llm_model=~\"$model\"}[5m])))",
          "legendFormat": "{{llm_model}} P50"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, llm_model) (rate(llm_call_duration_bucket{llm_model=~\"$model\"}[5m])))",
          "legendFormat": "{{llm_model}} P90"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, llm_model) (rate(llm_call_duration_bucket{llm_model=~\"$model\"}[5m])))",
          "legendFormat": "{{llm_model}} P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 32,
      "title": "Request Throughput (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (agent_type) (rate(agent_run_count_total{agent_type=~\"$agent_type\"}[1m]))",
          "legendFormat": "{{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },

    {
      "id": 40,
      "title": "── Error & Resilience ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "collapsed": false
    },
    {
      "id": 41,
      "title": "Rate Limits / Retries / Circuit Breaker",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(llm_rate_limit_count_total{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "Rate Limit (429)"
        },
        {
          "expr": "sum(rate(llm_retry_count_total{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "Retries"
        },
        {
          "expr": "sum(rate(llm_circuit_breaker_open_total{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "Circuit Breaker Open"
        },
        {
          "expr": "sum(rate(llm_circuit_breaker_reject_total{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "CB Rejected Calls"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 42,
      "title": "Error Logs (LLM / Sub-agent)",
      "description": "에러 로그. 특정 trace_id로 Tempo 드릴다운 가능.",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\".+\"} | json | line_format \"[{{.agent_type}}] {{.message}} model={{.model}} error={{.error}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 43,
      "title": "Quota Rejections",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(quota_reject_count_total[5m]))",
          "legendFormat": "Quota Rejected"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }
      }
    },
    {
      "id": 44,
      "title": "Cache Performance",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(cache_hit_count_total[5m]))",
          "legendFormat": "Cache Hit"
        },
        {
          "expr": "sum(rate(cache_miss_count_total[5m]))",
          "legendFormat": "Cache Miss"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    }
  ]
}
