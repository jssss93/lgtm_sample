{
  "uid": "llm-observability",
  "title": "LLM Observability (Langfuse-style)",
  "tags": ["lgtm", "llm", "agent", "observability"],
  "description": "LLM 호출 상세 관측: 프롬프트/응답 탐색, 토큰/비용/레이턴시, 에러 추적. Langfuse 대체 대시보드.",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "custom",
        "query": "gpt-4.1,gpt-4.1-mini,gpt-4o",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "agent_type",
        "label": "Agent",
        "type": "custom",
        "query": "orchestrator,search,summarizer,coder",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "── KPI ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Total LLM Calls",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(agent_run_count_total{agent_type=~\"$agent_type\"})",
          "legendFormat": "Calls"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 3,
      "title": "Total Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(llm_cost_usd_total{llm_model=~\"$model\", agent_type=~\"$agent_type\"})",
          "legendFormat": "Cost"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Total Tokens",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(llm_token_usage_total{llm_model=~\"$model\", agent_type=~\"$agent_type\"})",
          "legendFormat": "Tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 100000 },
              { "color": "red", "value": 1000000 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Avg LLM Latency (P95)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_call_duration_seconds_bucket{llm_model=~\"$model\", agent_type=~\"$agent_type\"}[5m])))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(agent_error_count_total{agent_type=~\"$agent_type\"}[5m])) / sum(rate(agent_run_count_total{agent_type=~\"$agent_type\"}[5m])) * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 7,
      "title": "Cache Hit Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(cache_hit_count_total) / (sum(cache_hit_count_total) + sum(cache_miss_count_total)) * 100",
          "legendFormat": "Hit Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 60 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },

    {
      "id": 10,
      "title": "── Trace Explorer (Prompt / Response) ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "LLM Call Traces (클릭 → 프롬프트/응답 상세 보기)",
      "description": "llm-call span 목록. TraceID 클릭 시 Tempo에서 프롬프트·응답·토큰·비용 확인 가능.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "{ name = \"llm-call\" }",
          "queryType": "traceql",
          "limit": 50
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceService": false
            },
            "renameByName": {
              "traceID": "Trace ID",
              "traceName": "Operation",
              "startTime": "Start Time",
              "duration": "Duration (ms)",
              "traceService": "Service"
            }
          }
        }
      ],
      "options": {
        "sortBy": [{ "displayName": "Start Time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Tempo에서 열기",
                    "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22query%22:%22${__value.raw}%22,%22queryType%22:%22traceId%22%7D%5D%7D",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      }
    },

    {
      "id": 20,
      "title": "── Token & Cost Analytics ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Token Usage Rate (Prompt vs Completion)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (rate(llm_token_usage_total{llm_model=~\"$model\", agent_type=~\"$agent_type\"}[5m]))",
          "legendFormat": "{{type}} tokens/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 22,
      "title": "Cost Rate by Model ($/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (llm_model) (rate(llm_cost_usd_total{llm_model=~\"$model\", agent_type=~\"$agent_type\"}[5m])) * 60",
          "legendFormat": "{{llm_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 23,
      "title": "Avg LLM Latency by Model",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (llm_model) (rate(llm_call_duration_seconds_sum{llm_model=~\"$model\"}[5m])) / sum by (llm_model) (rate(llm_call_duration_seconds_count{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "{{llm_model}} avg latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 24,
      "title": "Cumulative Cost by Agent Type",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (agent_type) (llm_cost_usd_total{agent_type=~\"$agent_type\"})",
          "legendFormat": "{{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      },
      "options": { "pieType": "donut", "tooltip": { "mode": "multi" } }
    },

    {
      "id": 30,
      "title": "── Latency Distribution ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "LLM Call Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, llm_model) (rate(llm_call_duration_seconds_bucket{llm_model=~\"$model\"}[5m])))",
          "legendFormat": "{{llm_model}} P50"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, llm_model) (rate(llm_call_duration_seconds_bucket{llm_model=~\"$model\"}[5m])))",
          "legendFormat": "{{llm_model}} P90"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, llm_model) (rate(llm_call_duration_seconds_bucket{llm_model=~\"$model\"}[5m])))",
          "legendFormat": "{{llm_model}} P99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 32,
      "title": "Request Throughput (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (agent_type) (rate(agent_run_count_total{agent_type=~\"$agent_type\"}[1m]))",
          "legendFormat": "{{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },

    {
      "id": 40,
      "title": "── Error & Resilience ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "collapsed": false
    },
    {
      "id": 41,
      "title": "Rate Limits / Retries / Circuit Breaker",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(llm_rate_limit_count_total{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "Rate Limit (429)"
        },
        {
          "expr": "sum(rate(llm_retry_count_total{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "Retries"
        },
        {
          "expr": "sum(rate(llm_circuit_breaker_open_total{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "Circuit Breaker Open"
        },
        {
          "expr": "sum(rate(llm_circuit_breaker_reject_total{llm_model=~\"$model\"}[5m]))",
          "legendFormat": "CB Rejected Calls"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 42,
      "title": "Error Logs (LLM / Sub-agent)",
      "description": "에러 로그. 특정 trace_id로 Tempo 드릴다운 가능.",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\".+\"} |~ \"(?i)(error|exception|fail)\" | line_format \"[{{.agent_type}} | {{.service_name}}] {{__line__}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 43,
      "title": "Quota Rejections",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(quota_reject_count_total[5m]))",
          "legendFormat": "Quota Rejected"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }
      }
    },
    {
      "id": 44,
      "title": "Cache Performance",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 51 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(cache_hit_count_total[5m]))",
          "legendFormat": "Cache Hit"
        },
        {
          "expr": "sum(rate(cache_miss_count_total[5m]))",
          "legendFormat": "Cache Miss"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },

    {
      "id": 50,
      "title": "── LLM Quality Evaluation ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 },
      "collapsed": false
    },
    {
      "id": 51,
      "title": "Avg Quality Score by Agent Type",
      "description": "에이전트별 응답 품질 점수 이동 평균 (1.0 = 최고, 0.0 = 최저). 길이·에러 키워드·문장 완결성 기반 휴리스틱.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (agent_type) (rate(llm_quality_score_sum{agent_type=~\"$agent_type\"}[5m])) / sum by (agent_type) (rate(llm_quality_score_count{agent_type=~\"$agent_type\"}[5m]))",
          "legendFormat": "{{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 52,
      "title": "Quality Score Percentiles (P50 / P90)",
      "description": "분위수 기반 품질 점수 분포. P90이 지속 하락하면 구조적 품질 문제 신호.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, agent_type) (rate(llm_quality_score_bucket{agent_type=~\"$agent_type\"}[5m])))",
          "legendFormat": "{{agent_type}} P50"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, agent_type) (rate(llm_quality_score_bucket{agent_type=~\"$agent_type\"}[5m])))",
          "legendFormat": "{{agent_type}} P90"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 53,
      "title": "Low Quality Response Rate (<0.5)",
      "description": "품질 점수 0.5 미만 응답 비율. 20% 초과 시 에이전트 프롬프트 또는 모델 점검 권장.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 66 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(llm_quality_score_bucket{le=\"0.5\", agent_type=~\"$agent_type\"}[5m])) / sum(rate(llm_quality_score_count{agent_type=~\"$agent_type\"}[5m])) * 100",
          "legendFormat": "Low Quality %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 60,
      "title": "── LLM-as-Judge Evaluation ──",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 74 },
      "collapsed": false
    },
    {
      "id": 61,
      "title": "Judge Overall Score by Agent Type",
      "description": "LLM-as-judge 종합 점수 (0~10). 에이전트 타입별 이동 평균. 샘플링 적용되므로 데이터 간격이 있을 수 있음.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 75 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (agent_type) (rate(llm_judge_overall_sum{agent_type=~\"$agent_type\"}[10m])) / sum by (agent_type) (rate(llm_judge_overall_count{agent_type=~\"$agent_type\"}[10m]))",
          "legendFormat": "{{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "green", "value": 7 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 62,
      "title": "Judge Score by Dimension (Avg, 1h)",
      "description": "4개 평가 차원 막대 비교. 특정 차원이 낮으면 해당 에이전트 프롬프트 또는 모델 조정 필요.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 75 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(llm_judge_relevance_sum{agent_type=~\"$agent_type\"}[1h])) / sum(rate(llm_judge_relevance_count{agent_type=~\"$agent_type\"}[1h]))",
          "legendFormat": "Relevance"
        },
        {
          "expr": "sum(rate(llm_judge_accuracy_sum{agent_type=~\"$agent_type\"}[1h])) / sum(rate(llm_judge_accuracy_count{agent_type=~\"$agent_type\"}[1h]))",
          "legendFormat": "Accuracy"
        },
        {
          "expr": "sum(rate(llm_judge_completeness_sum{agent_type=~\"$agent_type\"}[1h])) / sum(rate(llm_judge_completeness_count{agent_type=~\"$agent_type\"}[1h]))",
          "legendFormat": "Completeness"
        },
        {
          "expr": "sum(rate(llm_judge_overall_sum{agent_type=~\"$agent_type\"}[1h])) / sum(rate(llm_judge_overall_count{agent_type=~\"$agent_type\"}[1h]))",
          "legendFormat": "Overall"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "green", "value": 7 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 63,
      "title": "Low Judge Score Rate (<7) by Agent",
      "description": "judge 종합 점수 7 미만 비율. 20% 초과 시 프롬프트 또는 모델 점검 권장.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 83 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (agent_type) (rate(llm_judge_overall_bucket{le=\"7\", agent_type=~\"$agent_type\"}[1h])) / sum by (agent_type) (rate(llm_judge_overall_count{agent_type=~\"$agent_type\"}[1h])) * 100",
          "legendFormat": "{{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 64,
      "title": "Heuristic vs Judge Score Correlation",
      "description": "휴리스틱(0~1)과 LLM-judge(0~10, 정규화) 비교. 두 선이 크게 벌어지면 휴리스틱 신뢰도 점검 필요.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 83 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(llm_quality_score_sum{agent_type=~\"$agent_type\"}[5m])) / sum(rate(llm_quality_score_count{agent_type=~\"$agent_type\"}[5m]))",
          "legendFormat": "Heuristic (0~1)"
        },
        {
          "expr": "(sum(rate(llm_judge_overall_sum{agent_type=~\"$agent_type\"}[5m])) / sum(rate(llm_judge_overall_count{agent_type=~\"$agent_type\"}[5m]))) / 10",
          "legendFormat": "Judge Overall (normalized 0~1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },

    {
      "id": 54,
      "title": "Quality Issue Logs (에러 키워드 감지)",
      "description": "품질 저하 가능성이 있는 응답 로그. 에러 키워드 또는 짧은 응답 포함 호출을 추적합니다.",
      "type": "logs",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 66 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=~\".+\"} |= \"LLM call completed\" | line_format \"[{{.agent_type}}] model={{.model}} prompt={{.prompt_tokens}} completion={{.completion_tokens}} duration={{.duration}}s cost_usd={{.cost_usd}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
